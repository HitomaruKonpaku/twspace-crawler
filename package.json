{
  "name": "twspace-crawler",
  "version": "1.20.0",
  "description": "Script to monitor & download X (Twitter) Spaces 24/7",
  "keywords": [
    "node",
    "nodejs",
    "node-cli",
    "twitter-api",
    "twitter-spaces"
  ],
  "homepage": "https://github.com/HitomaruKonpaku/twspace-crawler#readme",
  "license": "ISC",
  "author": "HitomaruKonpaku",
  "bin": {
    "twspace-crawler": "dist/index.js"
  },
  "files": [
    "dist/**/*.js"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HitomaruKonpaku/twspace-crawler.git"
  },
  "scripts": {
    "start": "node dist/index",
    "start:config": "node dist/index --config ./config.json",
    "prepare": "npm run build",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc",
    "build:script": "npm run build && tsc -p script/tsconfig.json",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "jest test/unit",
    "test:e2e": "jest test/e2e",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "build-e2e-dataset": "npm run build:script && node dist/script/build-e2e-dataset.js"
  },
  "dependencies": {
    "@discordjs/builders": "^1.15.0",
    "axios": "^1.21.0",
    "bottleneck": "^2.19.5",
    "commander": "^15.0.0",
    "dotenv": "^18.0.9",
    "js-yaml": "^5.5.0",
    "m3u8-parser": "^7.2.1",
    "node-notifier": "^12.0.0",
    "open": "^11.0.4",
    "tslib": "^2.9.1",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "x-client-transaction-id": "^0.3.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.5",
    "@types/m3u8-parser": "^7.2.5",
    "@types/node": "^24.19.2",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^10.14.0",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.15",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "jest": {
      "node-notifier": "$node-notifier"
    },
    "glob": "^14.0.3",
    "minimatch": "^11.0.4"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  }
}
